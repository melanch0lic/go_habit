# Copy to `.env` (git-ignored) and fill in. The file is bundled into the app,
# so it must only contain PUBLIC client values.
#
# Local Supabase: values are printed by `supabase start` / `supabase status`.
# Hosted project: Dashboard → Project Settings → API.
SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Projects that only have the legacy anon JWT
# can set SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# NEVER add the service_role / secret key or the database password here.
