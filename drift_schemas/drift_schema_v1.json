    {
      "name": "habit_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"last_time_completed\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES habit_categories (id), \"is_pending_sync\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pending_sync\" IN (0, 1)), \"steps\" INTEGER NOT NULL DEFAULT 0, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"sync_status\" TEXT NOT NULL DEFAULT 'add', \"icon\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_completions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" TEXT NOT NULL REFERENCES habits (id), \"date_complete\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "habit_streaks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_streaks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" TEXT NOT NULL REFERENCES habits (id), \"current_streak\" INTEGER NOT NULL, \"last_update\" INTEGER NOT NULL);"
        }
      ]
