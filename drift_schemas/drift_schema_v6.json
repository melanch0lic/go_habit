  "fixed_sql": [
    {
      "name": "habit_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES habit_categories (id), \"is_pending_sync\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pending_sync\" IN (0, 1)), \"steps\" INTEGER NOT NULL DEFAULT 0, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"icon\" TEXT NOT NULL DEFAULT '', \"deleted_at\" INTEGER NULL, \"local_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_completions\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id), \"completed_on\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_pending_sync\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pending_sync\" IN (0, 1)), \"local_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"completed_on\"));"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "habit_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_templates\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"target_value\" INTEGER NULL, \"target_unit\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "community_memberships",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"community_memberships\" (\"template_id\" TEXT NOT NULL, \"habit_id\" TEXT NULL, \"joined_on\" TEXT NOT NULL, PRIMARY KEY (\"template_id\"));"
        }
      ]
    },
    {
      "name": "social_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"social_cache\" (\"key\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
